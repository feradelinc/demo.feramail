+test('template byIndex forwards an explicit projection, preserving full lookup when omitted',async()=>{let query;class Model{static init(){}static findOne(q){query=q;return q;}}const dataTypes=new Proxy({},{get:()=>Object.assign(()=>({}),{UUID:'uuid'})});const Template=load('models/Template.js',{sequelize:{Model,DataTypes:dataTypes},'../config/db':{},'../support/rendering':{},'./Log':{}});await Template.byIndex({ownerUuid:'owner',name:'Name',attributes:['uuid','name']});assert.deepEqual([...query.attributes],['uuid','name']);assert.equal(query.where.ownerUuid,'owner');await Template.byIndex({ownerUuid:'owner',name:'Name'});assert.equal(query.attributes,undefined);});
